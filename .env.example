# Root environment — TEMPLATE ONLY (no real values here).
#
# Copy this file to  .env  (git-ignored, NEVER committed) and paste the real
# values locally. Brand-scoped credentials stay in Brands/<CODE>/.env — this file
# is only for platform-level integrations.
#
# ── Lark: AI Email Automation System (internal app) ────────────────────────
# Used by the read-only Campaign Calendar provider
# (platform/integrations/calendar/providers/lark-provider.js).
#
# The App Secret is read from here into memory only. It is never logged, never
# written to source, and never sent anywhere except the Lark token endpoint.
# Rotate it in the Lark Developer Console if it is ever pasted into a chat,
# ticket, or terminal.
#
# Non-secret connection settings (Base app token, table id, view id) live in
# config/lark-calendar.json, not here.

LARK_APP_ID=
LARK_APP_SECRET=

# ── ImageKit: CDN image hosting (primary provider for campaign assets) ────
# Used by Scripts/imagekit-upload.js and Scripts/imagekit-watcher.js.
# The Private Key is read from here into memory only. It is never logged, never
# written to source, and never sent anywhere except the ImageKit API.

IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
