# SectorCare (SC) credentials — TEMPLATE ONLY (no real values here).
#
# Copy this file to  Brands/SC/.env  (git-ignored, NEVER committed) and paste the
# real values. Format: "KEY: VALUE" (the loader also accepts KEY=VALUE).

# Klaviyo private API key (pk_...) for the SC Klaviyo account. Brand-prefixed name
# enforces isolation (RDD=KLAVIYO_API_KEY, SS=SS_KLAVIYO_API_KEY). Least-privilege
# scopes: Campaigns:Full · Templates:Full · Lists:Read · Accounts:Read.
# The platform creates DRAFTS ONLY (platform/integrations/klaviyo/safety.js).
SC_KLAVIYO_API_KEY: pk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

