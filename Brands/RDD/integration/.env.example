# RDD BigCommerce credentials — TEMPLATE ONLY (no real values here).
#
# Copy this file to  Brands/RDD/.env  and paste the real values from the
# BigCommerce API account. The .env file is git-ignored and must NEVER be
# committed. This integration is READ-ONLY; the token only needs the
# "Products: read-only" (Content / Products read) OAuth scope.
#
# Format note: keys use the store's existing "KEY: VALUE" convention
# (space in the key, colon delimiter). The loader also accepts KEY=VALUE.

# Full v3 API path — the store hash is parsed out of this URL automatically.
# Example shape (NOT a real hash):
#   API PATH: https://api.bigcommerce.com/stores/XXXXXXXXXX/v3/
API PATH:

# BigCommerce X-Auth-Token (the secret). Read-only scope is sufficient.
ACCESS TOKEN:

# Optional — only needed if the store hash is NOT derivable from API PATH.
# STORE HASH:

# Optional — overrides the canonical storefront origin used to build product
# URLs. Defaults to https://www.retaildisplaydirect.com.au when omitted.
# STORE DOMAIN:

# ---------------------------------------------------------------------------
# Klaviyo (added for the Draft MVP — key NAME only, never a value here).
# One brand = one .env. Copy to Brands/RDD/.env and paste the real key.
# Private API key (pk_...). Least-privilege scopes recommended:
#   Campaigns: Full · Templates: Full · Lists: Read · Accounts: Read
# The platform creates DRAFTS ONLY and has no send capability (see
# platform/integrations/klaviyo/safety.js). No API calls occur until T4+.
# KLAVIYO_API_KEY: pk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
