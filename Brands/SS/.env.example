# Safety Sector (SS) credentials — TEMPLATE ONLY (no real values here).
#
# Copy this file to  Brands/SS/.env  (git-ignored, NEVER committed) and paste the
# real values. Format: "KEY: VALUE" (the loader also accepts KEY=VALUE).

# Klaviyo private API key (pk_...) for the SS Klaviyo account. Brand-prefixed name
# enforces isolation (RDD=KLAVIYO_API_KEY, SC=SC_KLAVIYO_API_KEY). Least-privilege
# scopes: Campaigns:Full · Templates:Full · Lists:Read · Accounts:Read.
# The platform creates DRAFTS ONLY (platform/integrations/klaviyo/safety.js).
SS_KLAVIYO_API_KEY: pk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# BigCommerce (SS product source) — optional until the SS product pipeline is enabled.
# Read-only "Products: read-only" scope is sufficient. The store hash is parsed from API PATH.
# API PATH: https://api.bigcommerce.com/stores/XXXXXXXXXX/v3/
# ACCESS TOKEN:
